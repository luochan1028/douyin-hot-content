# ========== 抖音热点内容自动生成与发布系统 - 配置文件 ==========
# 复制本文件为 .env 并按需修改

# ----- 数据库 -----
DATABASE_URL=sqlite:///./app.db

# ----- 抓取频率（分钟）-----
CRAWL_PEAK_INTERVAL=5
CRAWL_OFFPEAK_INTERVAL=30
PEAK_HOURS=11,12,18,19,20,21

# ----- 热度阈值 -----
HEAT_THRESHOLD=100
HEAT_SCORE_BURST=40

# ----- 可信度阈值 -----
CREDIBILITY_PASS=60
CREDIBILITY_REVIEW=40

# ----- 账号定位 -----
ACCOUNT_CATEGORY=科技
ACCOUNT_TAGS=AI,人工智能,科技,数码,职场
COPYWRITING_STYLE=专业科普

# ----- 发布风控 -----
DAILY_PUBLISH_LIMIT=3
PUBLISH_INTERVAL_HOURS=2
PUBLISH_RETRY_TIMES=3

# ----- 通知渠道（留空表示不启用）-----
DINGTALK_WEBHOOK=
WECOM_WEBHOOK=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# ----- 可插拔 AI（默认不启用，保持零成本）-----
# 本地 Ollama 地址，如 http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b
# 本地 Stable Diffusion WebUI 地址
SD_BASE_URL=

# ----- Web 服务 -----
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ----- Redis（可选，留空降级为内存缓存）-----
REDIS_URL=

# ----- FFmpeg -----
# Linux 云主机：保持 ffmpeg（需 apt install ffmpeg）
# Windows 本地：指定绝对路径，如 C:\path\to\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
